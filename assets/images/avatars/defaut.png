<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
    <defs>
        <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#7c3aed;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
        </linearGradient>
    </defs>
    <rect width="100" height="100" rx="50" fill="url(#grad)"/>
    <circle cx="50" cy="35" r="18" fill="white" opacity="0.8"/>
    <circle cx="43" cy="32" r="3" fill="#333"/>
    <circle cx="57" cy="32" r="3" fill="#333"/>
    <path d="M40 40 Q50 48 60 40" stroke="#333" stroke-width="2" fill="none"/>
    <rect x="30" y="55" width="40" height="25" rx="5" fill="white" opacity="0.8"/>
</svg>